# MineGuard Environment Configuration (§14.4)

# Database
# Default: local SQLite
DATABASE_URL=sqlite+aiosqlite:///./subnet.db
# Deployed stack: TimescaleDB + PostGIS
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/subnet

# MQTT Broker (unset => gateways use HTTP POST /api/ingest)
# MQTT_HOST=localhost
# MQTT_PORT=1883
# MQTT_UPLINK_TOPIC=subnet/gw/+/up
# MQTT_DOWNLINK_TOPIC=subnet/gw/{gateway}/cmd

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Operator-facing safety thresholds (kept server-side so clients cannot diverge)
TILT_THRESHOLD_DEG=0.60
STRAIN_THRESHOLD_MM_PER_M=3.00
VIBRATION_THRESHOLD_MG=400.0
TILT_RATE_THRESHOLD_DEG_PER_H=0.05
TILT_DRIFT_MDEG_PER_C=18.0
TILT_RATE_WINDOW_HOURS=6.0
NODE_STALE_SECONDS=180

# Optional ML Extension Service
# ML_SERVICE_URL=http://localhost:8100

# -----------------------------------------------------------------------------
# Authentication & Security (§15)
# -----------------------------------------------------------------------------
# Cryptographic secret key for signing JWTs and session tokens (minimum 32 characters)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
# Active session duration in days
SESSION_EXPIRE_DAYS=7
# One-time password reset token expiry in hours
PASSWORD_RESET_EXPIRE_HOURS=1
# Set to true in production HTTPS environments to enforce Secure cookie flag
SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# -----------------------------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/callback

# -----------------------------------------------------------------------------
# Email Provider (SMTP - Optional, for password reset and email verification)
# -----------------------------------------------------------------------------
# If unconfigured, password reset tokens are logged to server console in dev mode
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# EMAILS_FROM_EMAIL=alerts@mineguard.local

# -----------------------------------------------------------------------------
# SMS Provider (Twilio - Optional, for phone verification and SMS alerts)
# -----------------------------------------------------------------------------
# If unconfigured, phone registration succeeds and UI displays provider configuration instructions
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
