# Copy to .env and adjust. `make up` reads this file.

POSTGRES_USER=subnet
POSTGRES_PASSWORD=subnet
POSTGRES_DB=subnet
DB_PORT=5432

MQTT_PORT=1883
MQTT_WS_PORT=9001
REDIS_PORT=6379
API_PORT=8000
ML_PORT=8100
WEB_PORT=5173

# --- Alerting ---------------------------------------------------------------
# SMS is sent by the gateway's own SIM800L, so no SMS gateway credentials are
# needed here. Email is optional and only used by the backend alert dispatcher.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@subsidence-net.local
ALERT_EMAIL_TO=

# --- Demo -------------------------------------------------------------------
DEMO_SITE=jharia
