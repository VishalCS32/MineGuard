# MineGuard Web Frontend Environment Variables

# Backend API Base URL (HTTP/HTTPS)
# Local development default: http://localhost:8000
# Production / Remote default: https://mineguard-api.tenant.eu.org
VITE_API_BASE_URL=http://localhost:8000

# Backend Real-time Telemetry WebSocket URL (WS/WSS)
# Local development default: ws://localhost:8000/api/telemetry/ws
# Production / Remote default: wss://mineguard-api.tenant.eu.org/api/telemetry/ws
VITE_WS_BASE_URL=ws://localhost:8000/api/telemetry/ws

# Default Node Identifier
VITE_DEFAULT_NODE_ID=NODE-001

# Google OAuth 2.0 Client ID (Optional if using backend-redirect OAuth flow)
# Must match the GOOGLE_CLIENT_ID configured on the backend
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
