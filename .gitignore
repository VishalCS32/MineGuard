.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.env
node_modules/
dist/
build/
*.log
/models/
data/generated/
.pio/
android/local.properties
android/.gradle/

# Local development database (SQLite); the deployed stack uses TimescaleDB.
*.db
*.db-journal
*.db-wal
*.db-shm

# ESP-IDF generates these per checkout. sdkconfig.defaults is the file that is
# actually checked in -- the generated sdkconfig is derived from it, and
# committing one would let a stale local setting outlive the defaults.
firmware/*/sdkconfig
firmware/*/sdkconfig.old
firmware/*/managed_components/
firmware/*/dependencies.lock

# Temporary zip archives
mineguard-web.zip
