# Bearer token required on POST /api/v1/telemetry.
# UNSET MEANS OPEN. Set it before this is reachable from the internet.
INGEST_TOKEN=change-me

# SQLite by default (a file next to the app). Postgres for anything that has
# to survive a container restart -- most hosts give you an ephemeral disk.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated origins for the browser dashboard. "*" is fine while the
# read endpoints are public; narrow it if you ever put auth on them.
CORS_ORIGINS=*
